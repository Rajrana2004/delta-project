<style>
  .search-btn {
    background-color: #fe424d;
    color: #fff;
    border-radius: 25px;
    padding: 0 1rem 0 1rem;
  }
  .search-btn:hover {
    background-color: #fe424d;
    color: #fff;
  }
  .search-btn i {
    display: inline;
    margin-right: 0.5rem;
  }
  .search-inp {
    border-radius: 25px;
    padding: 0.5rem 3rem 0.5rem 3rem;
    font-size: 1rem;
  }
  nav.navbar {
    height: auto !important;
    min-height: 5rem;
    overflow: visible !important;
  }
  @media (max-width: 767px) {
    .search-inp { padding: 0.5rem 1rem; }
    .navbar-collapse { padding: 0.5rem 0 1rem; }
  }
  .mobile-search { flex: 1 1 0; min-width: 0; }
  .mobile-search .search-inp { min-width: 0; width: 100%; padding: 0.4rem 1rem; font-size: 0.9rem; }
  .mobile-search .search-btn { padding: 0 0.9rem; }
  .mobile-search .search-btn i { margin-right: 0; }
</style>

<nav class="navbar navbar-expand-md bg-body border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings"><i class="fa-regular fa-compass"></i></a>

    <form class="d-flex d-md-none mx-2 mobile-search" role="search" action="/listings" method="GET">
      <input class="form-control me-1 search-inp" type="search" name="q" placeholder="Search destinations" value="<%= locals.q || '' %>" />
      <button class="btn search-btn" type="submit" aria-label="Search">
        <i class="fa-solid fa-magnifying-glass"></i>
      </button>
    </form>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <a class="nav-link" href="/listings">Explore</a>
      </div>

      <div class="navbar-nav ms-auto">
        <form class="d-none d-md-flex" role="search" action="/listings" method="GET">
          <input class="form-control me-2 search-inp" type="search" name="q" placeholder="Search destinations" value="<%= locals.q || '' %>" />
          <button class="btn search-btn" type="submit">
            <i class="fa-solid fa-magnifying-glass"></i>Search
          </button>
        </form>
      </div>

      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/listings/new">Airbnb your home</a>
        <% if(!currUser) { %>
          <a class="nav-link" href="/signup"><b>Sign up</b></a>
          <a class="nav-link" href="/login"><b>Log in</b></a>
        <% } %>
        <% if(currUser) { %>
          <a class="nav-link" href="/logout"><b>Log out</b></a>
        <% } %>
      </div>
    </div>
  </div>
</nav>

<script>
  const q = new URLSearchParams(window.location.search).get("q");
  if (q) {
    document.querySelectorAll(".search-inp").forEach(i => i.value = q.trim());
  }
</script>